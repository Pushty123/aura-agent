<?xml version="1.0" encoding="utf-8"?>
<!-- Proposal for Backend A, not wired (4x2 Medium Widget) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root_medium"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="horizontal"
  android:gravity="center_vertical"
  android:padding="16dp"
  android:background="@drawable/widget_card_bg">

  <FrameLayout
    android:layout_width="88dp"
    android:layout_height="88dp">
    <ImageView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:src="@drawable/widget_ring_track"
      android:contentDescription="@null" />
    <ImageView
      android:id="@+id/widget_ring_arc"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:src="@drawable/widget_ring_arc"
      android:contentDescription="@null" />
    <TextView
      android:id="@+id/widget_score"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:text="—"
      android:textColor="@color/aura_text"
      android:textSize="22sp"
      android:textStyle="bold" />
  </FrameLayout>

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_marginStart="16dp"
    android:orientation="vertical">

    <TextView
      android:id="@+id/widget_status_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="AURA"
      android:textColor="@color/aura_muted"
      android:textSize="11sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_insight_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Unlock AURA to view"
      android:textColor="@color/aura_text"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_open_cta"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="Open AURA"
      android:textColor="@color/aura_primary"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
